# =========================================================
# Variables de Entorno - eve-77-agent
# =========================================================

# Proveedor de LLM (Configura el que vayas a utilizar)
# Para Vercel AI Gateway:
AI_GATEWAY_API_KEY=

# O Proveedores Directos:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Servidor y Puerto
PORT=3000
HOST=0.0.0.0

# Persistencia de Estado en Vercel Serverless (Opcional en dev, recomendado en prod)
# Para desarrollo local se usa RAM automáticamente si no se define REDIS_URL.
# Para producción en Vercel (Upstash Redis o Redis Cloud):
# REDIS_URL=rediss://default:tu_password@tu_host.upstash.io:6379

# Autenticación y Seguridad (Opcional en dev, recomendado en prod)
# EVE_TOKEN=tu_token_secreto_para_sofia_y_clientes_externos
