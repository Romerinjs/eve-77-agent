# =========================================================
# Variables de Entorno - eve-77-agent (77 Studio)
# =========================================================

# --- Proveedor de Inteligencia Artificial ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# O Proveedores Opcionales:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Servidor y Puerto ---
PORT=3007
HOST=0.0.0.0

# --- Kapso WhatsApp Cloud API (Adaptador Oficial) ---
# https://chat-sdk.dev/adapters/vendor-official/kapso
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=tu_secreto_de_webhook_configurado_en_kapso
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp
KAPSO_VERIFY_SIGNATURES=false # Cambiar a true en producción

# --- Persistencia de Estado Distribuido & Buffer (Upstash Redis) ---
# En local se usa MemoryState en RAM automáticamente si REDIS_URL está vacío.
# En producción (Dokploy / Vercel):
REDIS_URL=rediss://default:tu_password@tu_host.upstash.io:6379

# --- Seguridad y Tokens de API ---
EVE_TOKEN=
