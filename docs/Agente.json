    {
      "parameters": {
        "jsCode": "// 1. Obtenemos el texto acumulado de Redis\nlet rawText = $input.first().json.texto_completo || \"\";\n\n// 2. Rescatamos la descripción de la imagen PRIMERO (si existe y no está vacía)\nlet description = \"\";\nconst descriptionMatch = rawText.match(/\"description\":\\s*\"([^\"]+)\"/);\nif (descriptionMatch && descriptionMatch[1].trim() !== \"\") {\n  description = descriptionMatch[1];\n}\n\n// 3. Limpieza extrema del texto (Quitamos todo el código basura de Redis)\nlet content = rawText\n  .replace(/=\"text\":/g, \"\")                 // Quita la llave rara inicial\n  .replace(/\"text\":/g, \"\")                  // Quita etiquetas \"text\": repetidas\n  .replace(/\"description\":\\s*\"[^\"]*\"/g, \"\") // Borra la parte de description para no mezclarla\n  .replace(/\\\\n/g, \" \")                     // Reemplaza los \\n literales por espacios\n  .replace(/\\n/g, \" \")                      // Reemplaza saltos de línea reales\n  .replace(/=/g, \"\")                        // Borra signos de igual sueltos\n  .replace(/\"/g, \"\")                        // Elimina TODAS las comillas sobrantes\n  .replace(/\\s+/g, \" \")                     // Condensa múltiples espacios en uno solo\n  .trim();\n\n// Si al final quedó una coma suelta por la unión de Redis, la quitamos\ncontent = content.replace(/,$/, \"\").trim();\n\n// 4. Recuperamos los datos del Set Fields\nconst datosIniciales = $('Set Fields').first().json;\n// Calculamos la hora exacta de Colombia\nconst fechaCol = new Date(new Date().toLocaleString(\"en-US\", {timeZone: \"America/Bogota\"}));\nconst h = fechaCol.getHours();\nconst m = fechaCol.getMinutes();\n\nlet saludo = \"Buenas noches\"; // Por defecto (cubre de 6:31pm a 3:59am)\nif (h >= 4 && h < 12) {\n    saludo = \"Buenos días\";\n} else if (h >= 12 && (h < 18 || (h === 18 && m <= 30))) {\n    saludo = \"Buenas tardes\";\n}\n\nreturn {\n  instance: datosIniciales.instance,\n  message: {\n    ...datosIniciales.message,\n    // ¡Aquí ya irá tu texto súper limpio!\n    content: content, \n    description: description || undefined,\n    timestamp: new Date().toISOString(),\n    saludo: saludo\n  },\n  user: datosIniciales.user,\n};"
      },
