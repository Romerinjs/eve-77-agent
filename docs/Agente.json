    {
      "parameters": {
        "jsCode": "// 1. Obtenemos el texto que te arrojó la IA \nlet aiResponse = $input.first().json.output || \"\";\n\n// 2. Le quitamos la \"basura\" de Markdown (```json y ```)\nlet cleanText = aiResponse.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n\n// 3. Convertimos ese texto limpio en un objeto real de JSON\nlet parsedData = {};\ntry {\n  parsedData = JSON.parse(cleanText);\n} catch (error) {\n  throw new Error(\"La IA no devolvió un JSON válido: \" + cleanText);\n}\n\n// 4. EL TRUCO PARA LOS SALTOS DE LÍNEA:\n// Convertimos los \"Enters\" reales en el código \"\\n\" literal.\n// Así, n8n no se rompe y Kapso lo traduce como un salto de línea en WhatsApp.\nlet mensajeSeguro = parsedData.message.replace(/\\r?\\n/g, \"\\\\n\");\n\n// 5. Entregamos los datos separados a n8n\nreturn {\n  phone: parsedData.phone,\n  message: mensajeSeguro,\n  url: parsedData.url,\n  boton: parsedData.mensaje_boton\n};"
      },
